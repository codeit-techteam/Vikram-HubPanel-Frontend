# Hub Panel — environment template
# Copy to .env.local for local development.

# Browser API base (same-origin proxy path; do not point at PostgreSQL/Redis)
NEXT_PUBLIC_API_BASE_URL=/backend-api/v1

# Server-side upstream for Next.js rewrites and SSR fetch (required in production)
API_PROXY_TARGET=https://bajriwala-backend-zkuxd.ondigitalocean.app

NEXT_PUBLIC_APP_NAME=HubOps Central

# Optional auth localStorage key overrides
# NEXT_PUBLIC_AUTH_TOKEN_KEY=hub_access_token
# NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=hub_refresh_token

# --- Vercel production (vikram-hub-panel-frontend.vercel.app) ---
# Set these in Vercel → Project → Settings → Environment Variables:
# NEXT_PUBLIC_API_BASE_URL=/backend-api/v1
# API_PROXY_TARGET=https://bajriwala-backend-zkuxd.ondigitalocean.app
# NEXT_PUBLIC_APP_NAME=HubOps Central
# NEXT_PUBLIC_AUTH_TOKEN_KEY=hub_access_token
# NEXT_PUBLIC_AUTH_REFRESH_TOKEN_KEY=hub_refresh_token
